{
  "manifest_version": 3,
  "name": "Focus Feed",
  "version": "1.1.1",
  "description": "Hides the X and LinkedIn feeds and notifications (messages stay). Posting still works. Unlock the feed by staying on the page for 15 seconds.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Focus Feed",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://x.com/*",
        "*://*.x.com/*",
        "*://twitter.com/*",
        "*://*.twitter.com/*",
        "*://*.linkedin.com/*"
      ],
      "css": [
        "focus.css"
      ],
      "js": [
        "focus.js"
      ],
      "run_at": "document_start"
    }
  ]
}
